+class CanonicalStateReader:
+    """Lazily materialize a calibrated dense-state checkpoint on first use."""
+
+    def __init__(self, path: str) -> None:
+        self.path = Path(path)
+        self._state: dict[str, torch.Tensor] | None = None
+        self.metadata: dict[str, Any] | None = None
+
+    def get(self, name: str) -> torch.Tensor:
+        if self._state is None:
+            payload = torch.load(self.path, map_location="cpu", mmap=True,
+                                 weights_only=True)
+            state = payload.get("state_dict")
+            if not isinstance(state, dict):
+                raise ValueError(f"canonical state has no state_dict: {self.path}")
+            self._state = state
+            metadata = payload.get("metadata", {})
+            self.metadata = metadata if isinstance(metadata, dict) else {}
+        try:
+            return self._state[name]
+        except KeyError as exc:
+            raise KeyError(f"canonical state {self.path} lacks {name}") from exc
+
+
