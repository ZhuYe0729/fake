    Tensor tCrA_mma = mma_thread_slice.partition_fragment_A(sA(_,_,Int<0>{}));

    Tensor tCrA_load = [&]{
      if constexpr (not is_layout<SwappedStrideA>::value) {

        return make_fragment_like<RealSwappedElementA>(tCrA_mma);
