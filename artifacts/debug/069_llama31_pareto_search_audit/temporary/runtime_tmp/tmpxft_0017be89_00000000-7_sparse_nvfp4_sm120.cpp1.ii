# 599 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/threadblock/regular_tile_access_iterator_tensor_op_sm80.h"
 void add_tile_offset(TensorCoord const &coord) {

    add_pointer_offset(coord.strided() * Shape::kStrided + coord.contiguous() * Shape::kContiguous * stride_);
  }
};
