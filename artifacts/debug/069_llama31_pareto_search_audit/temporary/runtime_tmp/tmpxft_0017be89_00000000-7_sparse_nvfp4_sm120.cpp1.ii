    Tensor mD_mnl = make_tensor(make_gmem_ptr(params.ptr_D[l_coord]), make_shape(M,N,mock_L), stride_d);
    Tensor gC_mnl = local_tile(mC_mnl, blk_shape_MNK, make_coord(_,_,_), Step<_1,_1, X>{});
    Tensor gD_mnl = local_tile(mD_mnl, blk_shape_MNK, make_coord(_,_,_), Step<_1,_1, X>{});

    Tensor gC = gC_mnl(_,_,m_coord,n_coord, mock_l_coord);
    Tensor gD = gD_mnl(_,_,m_coord,n_coord, mock_l_coord);


    auto thr_mma = tiled_mma.get_thread_slice(thread_idx);
    Tensor tCgD = thr_mma.partition_C(gD);
    Tensor tCgC = thr_mma.partition_C(gC);

    static_assert(is_static<FrgLayout>::value, "Accumulator layout must be static");
    static_assert(decltype(size(tCgC) == size(tCgD))::value, "Source and destination must have the same number of elements.")
                                                                        ;
    static_assert(decltype(size(tCgD) == size(accumulators))::value, "Accumulator count must have the same destination element count.")
                                                                          ;


    Tensor mD_crd = make_identity_tensor(make_shape(M,N));
    Tensor cD_mn = local_tile(mD_crd, take<0,2>(blk_shape_MNK), make_coord(m_coord, n_coord));
    Tensor tCcD = thr_mma.partition_C(cD_mn);


    if (epilogue_op.is_source_needed()) {
      #pragma unroll
      for (int i = 0; i < size(accumulators); ++i) {
        if (elem_less(tCcD(i), make_shape(M,N))) {
          tCgD(i) = epilogue_op(accumulators(i), tCgC(i));
        }
      }
    }

    else {
      #pragma unroll
      for (int i = 0; i < size(accumulators); ++i) {
        if (elem_less(tCcD(i), make_shape(M,N))) {
          tCgD(i) = epilogue_op(accumulators(i));
        }
      }
    }
  }

private:
  Params params;
};



}
}
