# 225 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/epilogue/threadblock/epilogue_depthwise.h"
 void compute_source_needed_(
      OutputOp const &output_op,
      OutputTileIterator destination_iterator,
      AccumulatorTile const &accumulators,
      OutputTileIterator source_iterator) {

    typename OutputTileIterator::Fragment source_fragment;

    source_fragment.clear();

    source_iterator.load(source_fragment);


    warp_tile_iterator_.store(accumulators);

    __syncthreads();

    typename SharedLoadIterator::Fragment aligned_accum_fragment;


    shared_load_iterator_.load(aligned_accum_fragment);

    typename OutputTileIterator::Fragment output_fragment;

    apply_output_operator_(output_fragment, output_op, aligned_accum_fragment, source_fragment);


    destination_iterator.store(output_fragment);
  }


  
