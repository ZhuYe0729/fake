# 47 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/util/print_tensor.hpp"
void
print_layout(Layout const& layout)
{
  static_assert(decltype(rank(layout) == Int<2>{})::value);

  int idx_width = num_digits(cosize(layout)) + 2;

  print(layout); print("\n");


  print("    ");
  for (int n = 0; n < size<1>(layout); ++n) { printf("  %*d ", idx_width-2, n); }
  printf("\n");


  for (int m = 0; m < size<0>(layout); ++m) {

    print("    ");
    for (int n = 0; n < size<1>(layout); ++n) {
      printf("+");
      for (int i = 0; i < idx_width; ++i) {
        printf("-");
      }
    }
    printf("+\n");

    printf("%2d  ", m);
    for (int n = 0; n < size<1>(layout); ++n) { printf("| %*d ", idx_width-2, int(layout(m,n))); }
    printf("|\n");
  }

  print("    ");
  for (int n = 0; n < size<1>(layout); ++n) {
    printf("+");
    for (int i = 0; i < idx_width; ++i) {
      printf("-");
    }
  }
  printf("+\n");
}


