# 354 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/threadblock/predicated_tile_iterator_2dthreadtile.h"
 void load(Fragment &frag) { load_with_pointer_offset(frag, 0); }


  
# 357 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/threadblock/predicated_tile_iterator_2dthreadtile.h" 3 4
