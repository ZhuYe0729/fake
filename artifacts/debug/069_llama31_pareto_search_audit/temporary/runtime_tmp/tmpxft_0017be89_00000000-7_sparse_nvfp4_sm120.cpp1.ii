# 264 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/gemm/threadblock/mma_multistage.h"
 void advance_smem_write_stage(
    IteratorA &iterator_A,
    IteratorB &iterator_B)
  {

    iterator_A.add_tile_offset({0, 1});
    iterator_B.add_tile_offset({1, 0});


    smem_iterator_A_.add_tile_offset({0, 1});
    smem_iterator_B_.add_tile_offset({1, 0});


    ++smem_write_stage_idx_;

    if (smem_write_stage_idx_ == Base::kStages) {

      smem_iterator_A_.add_tile_offset({0, -Base::kStages});
      smem_iterator_B_.add_tile_offset({-Base::kStages, 0});
      smem_write_stage_idx_ = 0;
    }
  }

  
# 287 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/gemm/threadblock/mma_multistage.h" 3 4
