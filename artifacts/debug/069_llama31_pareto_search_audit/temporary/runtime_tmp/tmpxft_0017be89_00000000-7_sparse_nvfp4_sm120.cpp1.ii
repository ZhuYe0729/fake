    Tensor dst_v = group_modes<1,R>(dst);

    if constexpr (is_static<decltype(shape(src_v))>::value && is_static<decltype(shape(dst_v))>::value) {
      static_assert(decltype(size<1>(src_v) == size<1>(dst_v))::value);


      auto dst_null = nullspace(layout<1>(dst_v));

      Tensor dst_n = zipped_divide(dst_v, make_tile(shape<0>(dst_v), dst_null));
      Tensor src_n = zipped_divide(src_v, make_tile(shape<0>(src_v), dst_null));

      static_assert(decltype(size<1>(src_n) == size<1>(dst_n))::value);
      static_assert(decltype((cosize<0,1>(dst_n.layout()) == Int<1>{}))::value, "Nullspace definition error");
      static_assert(decltype((cosize<0,1>(src_n.layout()) == Int<1>{}))::value, "Error: Ambiguous scatter detected in copy");
      static_assert(decltype((size<1,0>(dst_n) == Int<1>{}))::value);
      static_assert(decltype((size<1,0>(src_n) == Int<1>{}))::value);

      Tensor dst_c = dst_n(make_coord(_,Int<0>{}),make_coord(Int<0>{},_));
      Tensor src_c = src_n(make_coord(_,Int<0>{}),make_coord(Int<0>{},_));

      static_assert(decltype(size<1>(src_c) == size<1>(dst_c))::value);
      static_assert(decltype(shape<0>(dst_c) == shape<0>(dst))::value);
      static_assert(decltype(shape<0>(src_c) == shape<0>(src))::value);

      #pragma unroll
      for (int i = 0; i < size<1>(dst_c); ++i) {
        copy_atom.call(src_c(_,i), dst_c(_,i));
      }
    } else {
      #pragma unroll
      for (int i = 0; i < size<1>(dst_v); ++i) {
        copy_atom.call(src_v(_,i), dst_v(_,i));
      }
    }
  }
}






template <int MaxVecBits,
          class SrcEngine, class SrcLayout,
          class DstEngine, class DstLayout>

# 245 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/algorithm/copy.hpp" 3 4
__inline__ __attribute__((always_inline)) __attribute__((host)) __attribute__((device))

# 246 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/algorithm/copy.hpp"
void
copy(AutoVectorizingCopyWithAssumedAlignment<MaxVecBits> const&,
     Tensor<SrcEngine, SrcLayout> const& src,
     Tensor<DstEngine, DstLayout> & dst)
{
  constexpr int common_elem = decltype(max_common_vector(src, dst))::value;
  static_assert(is_integral<decltype(Int<common_elem>{} * sizeof_bits_v<typename DstEngine::value_type>)>::value, "Error: Attempting a subbit write!");

  if constexpr (common_elem > 1)
  {
    constexpr int align_bits = decltype(gcd(max_alignment(src), max_alignment(dst), Int<MaxVecBits>{}))::value;
    constexpr int vec_bits = gcd(common_elem * sizeof_bits_v<typename DstEngine::value_type>, align_bits);

    if constexpr ((vec_bits % 8) == 0 && sizeof_bits_v<typename DstEngine::value_type> < Int<vec_bits>{})
    {

      using VecType = uint_bit_t<vec_bits>;


      Tensor src_v = recast<VecType>(src);
      Tensor dst_v = recast<VecType>(dst);
      return copy_if(constant_fn<true_type>{}, src_v, dst_v);
    } else {
      return copy_if(constant_fn<true_type>{}, src, dst);
    }
  } else {
    return copy_if(constant_fn<true_type>{}, src, dst);
  }
}

