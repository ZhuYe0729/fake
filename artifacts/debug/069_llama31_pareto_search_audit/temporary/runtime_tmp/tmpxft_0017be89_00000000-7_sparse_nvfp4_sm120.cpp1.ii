struct InterleavedPredicatedTileIteratorParams {

  using Index = int32_t;
  using LongIndex = int64_t;





  LongIndex stride;
  LongIndex advance_row;
  LongIndex advance_column;





  
# 397 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/epilogue/threadblock/predicated_tile_iterator_params.h" 3 4
