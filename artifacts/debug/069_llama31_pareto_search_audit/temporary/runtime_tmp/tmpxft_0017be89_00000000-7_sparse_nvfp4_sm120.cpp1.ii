  uint64_t quotient = 0, remainder = 0;
  uint64_t const bit = 1;
  for (int32_t i=127; i>=0; --i) {
    uint64_t r = 0;
    if (i >= 64) {
      r = ((high >> (i - 64)) & bit);
    }
    else {
      r = ((low >> i) & bit);
    }
    remainder = (remainder << 1) | r;
    if (remainder >= divisor) {
      remainder -= divisor;
      quotient |= (bit << i);
    }
  }
  *remainder_ptr = remainder;
  return quotient;

}

