namespace cutlass {
namespace reference {
namespace device {
namespace thread {







template <
  typename TensorRefA,
  typename TensorRefB,
  typename TensorRefC,
  typename ScalarType,
  typename AccumulatorType,
  typename OutputTile,
  typename InnerProductOp = multiply_add<AccumulatorType>,
  typename ConvertOp = NumericConverter<typename TensorRefC::Element, ScalarType>
>
struct Gemm {

  using ElementA = typename TensorRefA::Element;
  using ElementB = typename TensorRefB::Element;
  using ElementC = typename TensorRefC::Element;






  ElementA A_tile[OutputTile::kColumn];


  ElementB B_tile[OutputTile::kRow];


  AccumulatorType accum[OutputTile::kColumn][OutputTile::kRow];






  
# 86 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/thread/gemm.h" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((device)) __attribute__((host))
  
# 87 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/thread/gemm.h"
 Gemm(AccumulatorType initial_accum = AccumulatorType(0)) {


    for (int i = 0; i < OutputTile::kColumn; ++i) {
      A_tile[i] = ElementA(0);
    }

    for (int j = 0; j < OutputTile::kRow; ++j) {
      B_tile[j] = ElementB(0);
    }


    #pragma unroll
    for (int j = 0; j < OutputTile::kColumn; ++j) {
      #pragma unroll
      for (int i = 0; i < OutputTile::kRow; ++i) {
        accum[j][i] = initial_accum;
      }
    }
  }


  
# 109 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/thread/gemm.h" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((device)) __attribute__((host))
  
# 110 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/thread/gemm.h"
 Gemm & multiply_add(
    gemm::GemmCoord problem_size,
    TensorRefA tensor_a,
    TensorRefB tensor_b,
    MatrixCoord output_coord = MatrixCoord()) {

    InnerProductOp inner_product_op;


    #pragma unroll 1
    for (int k = 0; k < problem_size.k(); ++k) {


      #pragma unroll
      for (int i = 0; i < OutputTile::kColumn; ++i) {
        if (output_coord.row() + i < problem_size.m()) {
          A_tile[i] = tensor_a.at(make_Coord(output_coord.row() + i, k));
        }
      }


      #pragma unroll
      for (int j = 0; j < OutputTile::kRow; ++j) {
        if (output_coord.column() + j < problem_size.n()) {
          B_tile[j] = tensor_b.at(make_Coord(k, output_coord.column() + j));
        }
      }


      #pragma unroll
      for (int j = 0; j < OutputTile::kRow; ++j) {
        #pragma unroll
        for (int i = 0; i < OutputTile::kColumn; ++i) {
          accum[j][i] = inner_product_op(A_tile[i], B_tile[j], accum[j][i]);
        }
      }
    }

    return *this;
  }


  
# 152 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/thread/gemm.h" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((device)) __attribute__((host))
  
# 153 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/thread/gemm.h"
 Gemm & epilogue(
    gemm::GemmCoord problem_size,
    ScalarType alpha,
    ScalarType beta,
    TensorRefC tensor_c,
    TensorRefC tensor_d,
    MatrixCoord output_coord = MatrixCoord()) {

    ConvertOp convert_op;


    for (int j = 0; j < OutputTile::kRow; ++j) {
      for (int i = 0; i < OutputTile::kColumn; ++i) {
        MatrixCoord coord = output_coord + MatrixCoord(i, j);
        if (coord.row() < problem_size.m() && coord.column() < problem_size.n()) {

          tensor_d.at(coord) = convert_op(
            alpha * ScalarType(accum[j][i]) +
            beta * ScalarType(tensor_c.at(coord))
          );
        }
      }
    }

    return *this;
  }
};



}
}
}
}
