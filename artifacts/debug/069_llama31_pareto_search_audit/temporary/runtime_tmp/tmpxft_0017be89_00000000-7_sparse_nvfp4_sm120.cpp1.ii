        load_wait_token = load_pipeline.consumer_try_wait(load_wait_state);
      }

      ConsumerToken acc_wait_token = acc_pipeline.consumer_try_wait(acc_pipe_consumer_state);

      cst_callbacks.begin();
      if (cst_callbacks.begin_sync_needed()) {
