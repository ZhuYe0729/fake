Array<float, 4> top_4_reduce_scalar(Array<float, 4> a, float scalar) {
  Array<float, 4> out;
  asm volatile(
      "{\n"
      "  .reg .f32 mx;\n"
      "  .reg .pred p0;\n"
      "  .reg .pred p1;\n"
      "  .reg .pred p2;\n"
      "  max.f32 mx, %7, %8;\n"
      "  setp.gtu.f32 p0, %4, %8;\n"
      "  setp.gtu.f32 p1, %5, %8;\n"
      "  setp.gtu.f32 p2, %6, %8;\n"
      "  selp.f32 %3, mx, %6, p2;\n"
      "  selp.f32 %2, %6, %8, p2;\n"
      "  selp.f32 %2, %2, %5, p1;\n"
      "  selp.f32 %1, %5, %8, p1;\n"
      "  selp.f32 %1, %1, %4, p0;\n"
      "  selp.f32 %0, %4, %8, p0;\n"
      "}\n" :
      "=f"(out[0]), "=f"(out[1]), "=f"(out[2]), "=f"(out[3]) :
      "f"(a[0]), "f"(a[1]), "f"(a[2]), "f"(a[3]), "f"(scalar));
  return out;
}


