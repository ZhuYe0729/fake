sm120_rr_smem_copy_selector_B() {
  if constexpr (UseF8f6f4) {
    if constexpr (sizeof_bits_v<ElementB> == 6) {
      return SM100_SU6_DU8x16_x4_LDSM_N{};
    }
    else if constexpr (sizeof_bits_v<ElementB> == 4) {
      return SM100_SU4_DU8x16_x4_LDSM_N{};
