constexpr auto
sm90_partition_for_epilogue(
    Tensor<Engine, LayoutMNL> mT,
    TileShapeMNK tile_shape_mnk,
    TileCoordMNKL tile_coord_mnkl,
    EpilogueTile epi_tile,
    TiledCopy tiled_copy,
    int thread_idx) {
  auto [m, n, k, l] = tile_coord_mnkl;
  auto coord_shape =
      make_coord(m, n, l)
    ;
  Tensor cT = local_tile(mT, take<0,2>(tile_shape_mnk), coord_shape);
  Tensor tCcT =
    sm90_partition_for_epilogue<ReferenceSrc>(cT, epi_tile, tiled_copy, thread_idx);

  return tCcT;
}
