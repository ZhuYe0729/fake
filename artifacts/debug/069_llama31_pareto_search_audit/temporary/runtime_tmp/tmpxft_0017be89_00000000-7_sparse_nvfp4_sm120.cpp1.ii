        cst_callbacks.end_loop(epi_m, epi_n);

        if (is_producer_load_needed) {

          load_wait_token = load_pipeline.consumer_try_wait(load_wait_state, is_last_iteration);
        }
      }
    }

    if constexpr (DelayTmaStore) {

