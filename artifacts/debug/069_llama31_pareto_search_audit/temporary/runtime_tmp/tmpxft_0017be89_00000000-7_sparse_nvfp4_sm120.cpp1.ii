# 359 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/epilogue/threadblock/predicated_tile_iterator_conv.h"
 void load(Fragment &frag) const {

    load_with_byte_offset(frag, 0);
  }


  
