    Tensor tTR_tBulkAcc = thread_t2r.partition_S(tBulkAcc_epi);
    return cute::make_tuple(tiled_t2r, thread_t2r, tTR_tBulkAcc, tTR_rAcc, tTR_rGlobAcc);
  }

