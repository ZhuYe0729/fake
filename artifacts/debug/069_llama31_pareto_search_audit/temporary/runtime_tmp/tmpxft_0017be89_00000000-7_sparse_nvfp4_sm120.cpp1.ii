template <int I, class OldShape, class OldStride, class NewShape, class NewStride>

# 683 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/atom/copy_traits_sm90_tma.hpp" 3 4
