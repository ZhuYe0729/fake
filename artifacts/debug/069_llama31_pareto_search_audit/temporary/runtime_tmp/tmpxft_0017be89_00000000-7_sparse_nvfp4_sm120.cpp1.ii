  template <class ProblemShape_MNKL>
  
# 823 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/gemm/collective/sm100_mma_array_warpspecialized.hpp" 3 4
