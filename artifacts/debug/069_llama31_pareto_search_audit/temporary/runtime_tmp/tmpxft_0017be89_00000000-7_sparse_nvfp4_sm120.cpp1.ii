 void operator()(
    FragmentC &D,
    FragmentA const &A,
    FragmentB const &B,
    FragmentC const &C
  ) const {


    using MmaOperandA = typename ArchMmaOperator::FragmentA;
    using MmaOperandB = typename ArchMmaOperator::FragmentB;
    using MmaOperandC = typename ArchMmaOperator::FragmentC;

    D = C;

