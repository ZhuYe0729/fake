    Tensor tBcBk = tBcB(_,_,_,*k_tile_iter);


    #pragma unroll
    for (int n = 0; n < size<0>(tBpB); ++n) {
      tBpB(n,0) = elem_less(get<0>(tBcBk(0,n,0)), N);
