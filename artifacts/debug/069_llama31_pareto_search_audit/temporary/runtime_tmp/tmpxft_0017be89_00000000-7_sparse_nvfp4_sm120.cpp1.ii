tfloat32_t copysign(tfloat32_t const& a, tfloat32_t const& b) {

  uint32_t a_mag = (a.raw() & 0x7fffffff);
  uint32_t b_sign = (b.raw() & 0x80000000);
  uint32_t result = (a_mag | b_sign);

  return tfloat32_t::bitcast(result);
}



