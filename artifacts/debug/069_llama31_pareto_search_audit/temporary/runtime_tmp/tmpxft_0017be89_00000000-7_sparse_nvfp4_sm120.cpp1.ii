template <class Fn, class Val>
struct FoldAdaptor {
  template <class X>
  
# 378 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/algorithm/tuple_algorithms.hpp" 3 4
