 __inline__ __attribute__((always_inline)) __attribute__((host)) __attribute__((device)) 
# 82 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/swizzle.hpp"
                  constexpr
  auto
  operator()(Offset const& offset) const
  {
    return apply(offset);
  }

  template <int B, int M, int S>
  
# 90 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/swizzle.hpp" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((host)) __attribute__((device)) 
# 90 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/swizzle.hpp"
