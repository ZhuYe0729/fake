};



template <typename Iterations, typename Delta>
struct OutputTileThreadMapHelpers {


  
# 79 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/epilogue/threadblock/output_tile_thread_map.h" 3 4
