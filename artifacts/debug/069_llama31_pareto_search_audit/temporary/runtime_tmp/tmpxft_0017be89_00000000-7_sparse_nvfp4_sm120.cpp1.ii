void
gemm(MMA_Atom<MMA> const& mma,
     Tensor<TD, DLayout> & D,
     Tensor<TA, ALayout> const& A,
     Tensor<TB, BLayout> const& B,
     Tensor<TC, CLayout> const& C)
{
  static_assert(decltype(size<1>(A) == size<1>(C))::value);
  static_assert(decltype(size<1>(B) == size<2>(C))::value);
  static_assert(decltype(size<2>(A) == size<2>(B))::value);
  static_assert(decltype(size<0>(C) == size<0>(D) && size<1>(C) == size<1>(D) && size<2>(C) == size<2>(D))::value);

  auto rA = MMA_Atom<MMA>::make_fragment_A(A);
  auto rB = MMA_Atom<MMA>::make_fragment_B(B);

  auto K = size<2>(A);

  #pragma unroll
  for (int k = 0; k < K; ++k)
  {
    copy(A(_,_,k), rA(_,_,k));
    copy(B(_,_,k), rB(_,_,k));

    gemm(mma, D, rA(_,_,k), rB(_,_,k), C);
  }
}

