template <class LayoutA, class TikzColorFn = TikzColor_BWx8>

# 84 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/util/print_latex.hpp" 3 4
