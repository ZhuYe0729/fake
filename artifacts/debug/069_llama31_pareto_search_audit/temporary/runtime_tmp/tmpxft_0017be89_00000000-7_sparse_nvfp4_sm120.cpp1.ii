  deduce_layoutA() {
    using LayoutMMajor = Layout<Shape <int32_t,
                                       Shape<ElementASparsity, int32_t>,
                                       int32_t>,
                                Stride<ElementASparsity,
                                       Stride<_1, int64_t>,
