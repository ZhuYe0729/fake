# 142 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/atom/copy_traits.hpp"
                constexpr
void
copy_unpack(AnyCPYTraits const& traits,
            Tensor<SEngine,SLayout> const& src,
            Tensor<DEngine,DLayout> && dst)
{
  copy_unpack(traits, src, dst);
}

