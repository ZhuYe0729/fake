          class SEngine, class SLayout,
          class... GTensors,
          typename cute::enable_if<(conjunction_v<is_tensor<GTensors>...>)>::type* = nullptr>

# 1417 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/atom/copy_traits_sm90_tma.hpp" 3 4
