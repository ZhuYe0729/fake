constexpr auto
sm90_partition_for_epilogue(
    CtaTileMN cT,
    EpilogueTile epi_tile,
    TiledCopy tiled_copy,
    int thread_idx) {
  ThrCopy thread_copy = tiled_copy.get_thread_slice(thread_idx);
  Tensor cT_epi = flat_divide(cT, epi_tile);
  if constexpr (ReferenceSrc) {
    return thread_copy.partition_S(cT_epi);
  }
  else {
    return thread_copy.partition_D(cT_epi);
  }
}

