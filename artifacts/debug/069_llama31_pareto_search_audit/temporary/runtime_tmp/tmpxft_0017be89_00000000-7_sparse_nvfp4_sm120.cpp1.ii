Element topk_logsumexp(cutlass::Array<Element, N> a) {




  Element sum = Element(1.0);
  #pragma unroll
  for (int i = 1; i < N; ++i) {
    sum += fast_exp(a[i] - a[0]);
  }
  return a[0] + fast_log(sum);
}


