 Array<half_t, N> operator()(Array<half_t, N> const &rhs) const {

    Array<half_t, N> result;


    __half2 const *in = reinterpret_cast<__half2 const *>(&rhs);
    __half2 *out = reinterpret_cast<__half2 *>(&result);

    #pragma unroll
