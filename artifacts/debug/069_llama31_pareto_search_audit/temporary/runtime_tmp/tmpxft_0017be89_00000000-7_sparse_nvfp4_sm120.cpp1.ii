                void
  load_tail(MainloopPipeline pipeline, PipelineState smem_pipe_write) {
    int lane_predicate = cute::elect_one_sync();


    if (lane_predicate) {






      pipeline.producer_tail(smem_pipe_write);
    }
  }



  template <
    class FrgTensorC,
    class BlockCoord
  >
  
# 714 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/gemm/collective/sm120_blockscaled_mma_tma.hpp" 3 4
