      "  max.f32 mxa3b0, %7, %8;\n"
      "  max.f32 mxa0b3, %4, %11;\n"

      "  .reg .pred pa0b0;\n"
      "  .reg .pred pa1b0;\n"
      "  .reg .pred pa2b0;\n"
      "  .reg .pred pa0b1;\n"
      "  .reg .pred pa1b1;\n"
      "  .reg .pred pa0b2;\n"
      "  .reg .pred pb2a0;\n"
      "  .reg .pred pb1a0;\n"

      "  setp.gtu.f32 pa0b0, %4, %8;\n"
      "  setp.gtu.f32 pa1b0, %5, %8;\n"
      "  setp.gtu.f32 pa2b0, %6, %8;\n"
      "  setp.gtu.f32 pa0b1, %4, %9;\n"
      "  setp.gtu.f32 pa1b1, %5, %9;\n"
