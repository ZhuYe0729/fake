template <typename T>
constexpr T identity_for_maximum() {
  if constexpr (numeric_limits<T>::has_infinity) {
    return -numeric_limits<T>::infinity();
  } else {
    return numeric_limits<T>::lowest();
  }
}



template <typename T>
constexpr T identity_for_minimum() {
  if constexpr (numeric_limits<T>::has_infinity) {
    return numeric_limits<T>::infinity();
  } else {
    return numeric_limits<T>::max();
  }
}


