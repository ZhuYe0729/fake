  template <
    class FrgTensorC,
    class BlockCoord
  >
  
# 800 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/gemm/collective/sm120_blockscaled_mma_array_tma.hpp" 3 4
