        tAgA_mkl, tBgB_nkl, tAsA, tBsB,
        mcast_mask_a, mcast_mask_b
    );

    if constexpr (IsTensorMapUpdateAsync) {
      return ret;
    }
    else {

      auto input_tensormaps = tensormaps_init<IsTensorMapUpdateAsync>(params, shared_tensormaps, sm_count, sm_idx);
