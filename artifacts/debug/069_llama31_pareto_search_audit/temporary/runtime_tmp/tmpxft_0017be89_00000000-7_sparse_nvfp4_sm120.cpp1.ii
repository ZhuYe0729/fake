 EpilogueBase(
    SharedStorage &shared_storage,
    int thread_idx,
    int warp_idx,
    int lane_idx
  ):
    shared_storage_(shared_storage),
    warp_tile_iterator_(shared_storage.reference(), lane_idx) {







