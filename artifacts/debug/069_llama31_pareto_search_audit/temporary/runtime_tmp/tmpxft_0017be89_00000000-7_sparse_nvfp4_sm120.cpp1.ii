 void load_with_byte_offset(

      Fragment &frag,

      TensorCoord const &tile_offset,

      Index byte_offset) const {

    Index pointer_offset =
      tile_offset.contiguous() * Shape::kContiguous / Layout::kElementsPerAccess +
