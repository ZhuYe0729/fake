namespace cute
{

template <uint32_t NumThreads,
          class SrcEngine, class SrcLayout,
          class DstEngine, class DstLayout>

# 48 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/algorithm/cooperative_copy.hpp" 3 4
__inline__ __attribute__((always_inline)) __attribute__((host)) __attribute__((device)) 
# 48 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/algorithm/cooperative_copy.hpp"
                void
naive_cooperative_copy(uint32_t const& tid,
                       Tensor<SrcEngine, SrcLayout> const& src,
                       Tensor<DstEngine, DstLayout> & dst)
{
  auto N = size(dst);
  auto R = N % Int<NumThreads>{};
  if (R > 0 && tid < R) {
    dst[tid] = src[tid];
  }
  #pragma unroll
  for (uint32_t i = uint32_t(R); i < uint32_t(N); i += NumThreads) {
    dst[tid + i] = src[tid + i];
  }
}


