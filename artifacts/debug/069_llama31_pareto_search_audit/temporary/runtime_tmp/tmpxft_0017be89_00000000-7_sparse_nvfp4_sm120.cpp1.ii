template <typename TC, int N, bool PropagateNaN>
struct maximum_cartesian_norm_zero_mantissa_reduction<cutlass::Array<TC, N>, PropagateNaN> {
  using T = typename TC::value_type;

  
# 833 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/complex.h" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((device)) __attribute__((host))
  
# 834 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/complex.h"
 T operator() (T const& scalar, cutlass::Array<TC, N> const& rhs) const {

    T result = scalar;
    maximum_cartesian_norm_zero_mantissa_reduction<TC, PropagateNaN> scalar_op;

    #pragma unroll
    for (int i = 0; i < N; ++i) {
      result = scalar_op(result, rhs[i]);
