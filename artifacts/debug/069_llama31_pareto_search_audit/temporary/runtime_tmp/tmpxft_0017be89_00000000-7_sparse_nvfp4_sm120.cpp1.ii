                auto
  load_init_cpasync(
      ProblemShape_MNKL const& problem_shape_MNKL,
      Params const& params,
      TensorStorage& shared_tensors,
      TileScheduler const& scheduler,
      typename TileScheduler::WorkTileInfo const& work_tile_info) const {
    using X = Underscore;

    auto [M,N,K,L] = problem_shape_MNKL;



    auto shape_b = make_shape(N, K, L);
    StrideB stride_b = cutlass::make_internal_packed_stride(StrideB{}, shape_b);

    Tensor mB_nkl = make_tensor(make_gmem_ptr(params.ptr_B), shape_b, stride_b);

    Tensor gB_nkl = local_tile(mB_nkl, TileShape{}, make_coord(_,_,_), Step< X,_1,_1>{});
    Tensor tBgB_nkl = flatten(flat_divide(gB_nkl, make_shape(safe_div(size(get<1>(TileShape{})), size(AtomThrShapeMNK{})))));


    Tensor cB_nk = make_identity_tensor(make_shape(N,K));

    Tensor cgB_nk = local_tile(cB_nk, TileShape{}, make_coord(_,_,_), Step< X,_1,_1>{});
    Tensor ctBgB_nk = flatten(flat_divide(cgB_nk, make_shape(safe_div(size(get<1>(TileShape{})), size(AtomThrShapeMNK{})))));

    Tensor sB = make_tensor(make_smem_ptr(shared_tensors.smem_B.data()), LoadSmemLayoutB{});

    GmemTiledCopyB gmem_to_smem_b_tiled_copy;

    int thread_idx = threadIdx.x % NumLoadThreadsCpAsync;
    auto thr_copy_b = gmem_to_smem_b_tiled_copy.get_slice(thread_idx);

    return cute::make_tuple(
      tBgB_nkl, ctBgB_nk, sB,
      gmem_to_smem_b_tiled_copy, thr_copy_b);
  }


