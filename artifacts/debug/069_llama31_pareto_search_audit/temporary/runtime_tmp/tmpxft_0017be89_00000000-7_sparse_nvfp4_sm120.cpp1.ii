# 410 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/gemm/collective/sm90_mma_array_tma_gmma_ss_warpspecialized_fp8_blockwise_scaling.hpp"
                auto
  load_init(
    ProblemShape_MNKL const& problem_shape_MNKL,
    Params const& mainloop_params,
    ElementBlockScale const* ptr_SFA = nullptr,
    ElementBlockScale const* ptr_SFB = nullptr
  ) const {

    using X = Underscore;

    auto [M,N,K,L] = problem_shape_MNKL;
    const int32_t init_L = 1;



    Tensor mA_mkl = mainloop_params.tma_load_a.get_tma_tensor(make_shape(M,K,init_L));
    Tensor mB_nkl = mainloop_params.tma_load_b.get_tma_tensor(make_shape(N,K,init_L));


    Tensor gA_mkl = local_tile(mA_mkl, TileShape{}, make_coord(_,_,_), Step<_1, X,_1>{});
    Tensor gB_nkl = local_tile(mB_nkl, TileShape{}, make_coord(_,_,_), Step< X,_1,_1>{});



    Tensor mSFA_mkl = make_tensor(make_gmem_ptr(ptr_SFA),
        ScaleConfig::tile_atom_to_shape_SFA(make_shape(M, N, K, init_L)));
    Tensor mSFB_nkl = make_tensor(make_gmem_ptr(ptr_SFB),
        ScaleConfig::tile_atom_to_shape_SFB(make_shape(M, N, K, init_L)));

    return cute::make_tuple(gA_mkl, gB_nkl, mSFA_mkl, mSFB_nkl);

  }



  template <
    class TensorA, class TensorB,
    class TensorMapA, class TensorMapB,
    class TensorScaleA, class TensorScaleB,
    class KTileIterator, class BlockCoord
  >
  
# 451 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/gemm/collective/sm90_mma_array_tma_gmma_ss_warpspecialized_fp8_blockwise_scaling.hpp" 3 4
