 static GeneralMatrix packed(
    MatrixCoord const &extent,
    Matrix layout_id = Matrix::kColumnMajor,
    Index interleave = 1) {

    Index c;
    if (layout_id == Matrix::kRowMajor) {
      c = extent.column();
    }
    else {
      c = extent.row();
    }

    Index ldm = c * interleave;

    return GeneralMatrix(layout_id, ldm, interleave);
  }



  
