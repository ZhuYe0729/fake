      RealElementB,
      InstMmaOperandB,
      FragmentB,
      MmaIterations,
      MatrixShape<2, 1>,
      kTransformB,
      Operand::kB,
      kRoundB> convert_B;


    convert_A(reinterpret_cast<InstMmaOperandA *>(&dst_A), A);
    convert_B(reinterpret_cast<InstMmaOperandB *>(&dst_B), B);
  }
