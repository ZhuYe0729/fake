void
gemm(ThrMMA<Args...> const& thr_mma,
     Alpha const& alpha,
     Tensor<TA, ALayout> const& sA,
     Tensor<TB, BLayout> const& sB,
     Beta const& beta,
     Tensor<TC, CLayout> & sC,
     ALoadTransformOp const& sA_load_op = {},
