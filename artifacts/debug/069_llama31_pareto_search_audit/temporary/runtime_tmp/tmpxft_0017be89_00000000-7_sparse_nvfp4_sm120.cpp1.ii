              {},
              {
                {{alpha}, {alpha_ptr}, {alpha_ptr_array}, {dAlpha}},
                {},
                {}
              },
              {}
            },
            activation
          },
          {block_scale_factor_ptr, norm_constant_ptr, dNormConst}
        };
    }
  };


  using Impl::Impl;
};





