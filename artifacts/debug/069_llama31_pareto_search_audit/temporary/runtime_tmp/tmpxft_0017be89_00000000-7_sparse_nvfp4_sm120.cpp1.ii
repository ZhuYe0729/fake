      } else if (Policy::LdsmShape::kContiguous == 2 &&
                 kOperand == Operand::kB) {



        partition_contiguous_idx = lane_in_quad / 2;
        access_strided_idx = lane_in_quad_quad / Layout::kFactor;
        access_contiguous_idx =
