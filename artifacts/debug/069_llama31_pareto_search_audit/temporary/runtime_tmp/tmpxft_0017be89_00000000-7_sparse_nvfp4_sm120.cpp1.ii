          Tensor tTR_tAcc_mn = tTR_tAcc(_,_,_,epi_m,epi_n);


          if constexpr (predicate_tmem_load) {

            int subpart_idx = (tTR_tAcc_mn.data().dp_ / 32) % 4;
            issue_tmem_load = warp_idx == subpart_idx;
          }


          if (issue_tmem_load) {
