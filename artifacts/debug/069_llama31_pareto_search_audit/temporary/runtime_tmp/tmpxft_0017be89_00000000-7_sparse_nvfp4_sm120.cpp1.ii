        MmaOperandB operand_B;

        #pragma unroll
        for (int mk = 0; mk < MmaOperandA::kElements; ++mk)
          operand_A[mk] = A[m*MmaOperandA::kElements + mk].real();

        #pragma unroll
        for (int nk = 0; nk < MmaOperandB::kElements; ++nk)
          operand_B[nk] = B[n*MmaOperandB::kElements + nk].real();


