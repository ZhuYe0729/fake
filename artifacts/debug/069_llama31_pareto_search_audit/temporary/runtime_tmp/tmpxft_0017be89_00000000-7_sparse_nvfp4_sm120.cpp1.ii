# 512 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/kernel/sm90_sparse_gemm_compressor.hpp"
 static void
  cooperative_clear(
    uint32_t const& tid,
    TensorSrc dSrc) {

    auto dSrctSrc = local_partition(dSrc, make_layout(make_shape(NumThreads, _1{})), tid);
    cute::clear(dSrctSrc);


