# 3518 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/atom/copy_traits_sm100.hpp"
                constexpr
void
copy_unpack(Copy_Traits<CopyOp> const& traits,
            Tensor<TS,SLayout> const& src,
            Tensor<TD,DLayout> & dst)
{
  static_assert(is_tmem<TS>::value, "Expected TMEM src.");
  static_assert(is_rmem<TD>::value, "Expected RMEM dst.");

  using SrcType = typename TS::value_type;
  static_assert(decltype((coalesce(layout(src)) == coalesce(upcast<sizeof_bits<SrcType>::value>(typename Copy_Traits<CopyOp>::ValID{}))))::value, "Expected src to have the specific TMEM layout required by CopyOp.")
                                                                        ;

  uint32_t tmem_addr = raw_pointer_cast(src.data());
  const float& row_max = traits.get_max();

  using RegTypeDst = typename remove_extent<typename CopyOp::DRegisters>::type;
  Tensor rD = recast<RegTypeDst>(dst);

  constexpr int RegNumDst = extent<typename CopyOp::DRegisters>::value;
  static_assert(decltype(size(rD) == Int<RegNumDst>{})::value, "In CopyAtom, dst layout doesn't vectorize into registers. This dst layout is incompatible with this CopyOp.")
                                                                                                                  ;




  
