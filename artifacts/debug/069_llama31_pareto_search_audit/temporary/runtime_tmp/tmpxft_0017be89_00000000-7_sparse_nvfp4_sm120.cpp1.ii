 void load(Fragment &frag, TensorCoord const & tile_offset) {
    load_with_pointer_offset(
      frag,
      tile_offset.contiguous() * Shape::kContiguous / ThreadMap::kElementsPerAccess +
        tile_offset.strided() * Shape::kStrided * stride_
    );
  }


  
