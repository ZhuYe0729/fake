struct LayoutAwareConvertImpl {
  template<class EngineIn, class EngineOut>
  
# 54 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/detail/collective/mixed_input_utils.hpp" 3 4
