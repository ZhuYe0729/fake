 __inline__ __attribute__((always_inline)) __attribute__((device))
  
# 351 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/epilogue/threadblock/predicated_tile_iterator_strided_dgrad.h"
 void load(Fragment &frag) {

    load_with_byte_offset(frag, 0);
  }


  
