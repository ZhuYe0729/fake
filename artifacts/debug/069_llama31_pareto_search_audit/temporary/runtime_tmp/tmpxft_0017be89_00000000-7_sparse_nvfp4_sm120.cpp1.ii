# 68 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/algorithm/axpby.hpp"
void
axpby(Alpha const& alpha,
      Tensor<XEngine, XLayout> const& x,
      Beta const& beta,
      Tensor<YEngine, YLayout> & y,
      PrdTensor const& p = {})
{
  auto isBetaZero = [&] () {
    if constexpr (is_complex<Beta>::value) {
      return beta.real() == Int<0>{} && beta.imag() == Int<0>{};
    }
    else {
      return beta == Int<0>{};
    }

    __builtin_unreachable();
  } ();

  #pragma unroll
  for (int i = 0; i < size(x); ++i) {
    if (p(i)) {
      y(i) = (isBetaZero ? alpha * x(i) : alpha * x(i) + beta * y(i));
    }
  }
}

}
