constexpr bool is_tensor_v = is_tensor<T>::value;


template <class T>
struct MakeTensor
{
  template <class Arg0, class... Args>
  
# 355 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/tensor_impl.hpp" 3 4
