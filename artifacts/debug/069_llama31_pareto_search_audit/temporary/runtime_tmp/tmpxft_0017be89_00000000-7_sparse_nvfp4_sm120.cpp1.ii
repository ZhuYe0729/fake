        if (params_aux.ptr_aux == nullptr) {
          return;
        }
      }


      constexpr auto MCL = decltype(max_common_layout(tC_rAux, tC_gAux)){};
      constexpr int V = cute::min(Alignment, size(MCL));

      if constexpr (V > 1 && V % 8 == 0) {
        using VecType = uint_bit_t<V>;
