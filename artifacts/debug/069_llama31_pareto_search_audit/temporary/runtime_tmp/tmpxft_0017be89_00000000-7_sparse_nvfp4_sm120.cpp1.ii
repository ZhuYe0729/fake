    Tensor mSFD = make_tensor(make_gmem_ptr(ptr_scale_factor),
                    Sm1xxBlockScaledOutputConfig::tile_atom_to_shape_SFD(args.problem_shape_mnkl));

    Tensor gSFD = local_tile(mSFD, args.epi_tile, make_coord(_, _,l));
