namespace cute
{

struct SM50_Shuffle_U32_2x2Trans_XOR1
{
  using SRegisters = uint32_t[2];
  using DRegisters = uint32_t[2];

  
# 49 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/arch/copy_sm50.hpp" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((host)) __attribute__((device)) 
# 49 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/arch/copy_sm50.hpp"
                  static void
  copy(uint32_t const& src0, uint32_t const& src1, uint32_t& dst0, uint32_t& dst1)
  {

    uint32_t x0 = src0;
    uint32_t y0 = __shfl_xor_sync(0xffffffff, x0, 1);

    uint32_t x1 = src1;
    uint32_t y1 = __shfl_xor_sync(0xffffffff, x1, 1);

    if (threadIdx.x % 2 == 0) {
      dst1 = y0;
    }
    else {
      dst0 = y1;
    }



  }
};


struct SM50_Shuffle_U32_2x2Trans_XOR4
{
  using SRegisters = uint32_t[2];
  using DRegisters = uint32_t[2];

  
# 77 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/arch/copy_sm50.hpp" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((host)) __attribute__((device)) 
# 77 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/arch/copy_sm50.hpp"
                  static void
  copy(uint32_t const& src0, uint32_t const& src1, uint32_t& dst0, uint32_t& dst1)
  {

    uint32_t x0 = threadIdx.x & 4 ? src0 : src1;
    uint32_t y0 = __shfl_xor_sync(0xffffffff, x0, 4);


    if (threadIdx.x & 0x4) {
      dst0 = y0;
    }
    else {
      dst1 = y0;
    }



  }
};


}
