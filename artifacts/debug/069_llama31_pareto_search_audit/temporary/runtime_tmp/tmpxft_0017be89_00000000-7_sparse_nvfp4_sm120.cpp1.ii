  static int const kAccessSizeInBits = 64;


  using Operator = Operator_;





  using SmemLayoutA = layout::RowMajorTensorOpMultiplicand64bCrosswise;

  using SmemLayoutB = layout::RowMajorTensorOpMultiplicandCongruous64b;







