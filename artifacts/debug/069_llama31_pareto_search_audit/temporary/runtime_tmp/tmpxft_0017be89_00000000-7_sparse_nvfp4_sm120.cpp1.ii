namespace cutlass {
namespace reference {
namespace detail {



template <int Rank, int Index>
struct LinearToCoordinateHelper {

  
# 50 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/detail/linear_to_coordinate.h" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((device)) __attribute__((host))
  
# 51 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/detail/linear_to_coordinate.h"
 void operator()(Coord<Rank> &coord, int64_t idx, Coord<Rank> const &extent) const {

    int64_t prod = 1;

    #pragma unroll
    for (int i = Rank - Index; i < Rank; ++i) {
      prod *= int64_t(extent[i]);
    }

    coord[Rank - Index - 1] = int(idx / prod);

    int64_t residual = idx % prod;
    LinearToCoordinateHelper<Rank, Index - 1>()(coord, residual, extent);
  }
};

template <int Rank>
struct LinearToCoordinateHelper<Rank, 0> {

  
