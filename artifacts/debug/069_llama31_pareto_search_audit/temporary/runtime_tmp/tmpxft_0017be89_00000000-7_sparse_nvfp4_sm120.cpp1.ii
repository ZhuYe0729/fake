  float* row_max_ = const_cast<float*>(&row_max);
  float tmp_row_max = row_max_[0];
  detail::explode(CopyOp::copy,
                  &tmem_addr, seq<0>{},
                  rD, make_seq<RegNumDst>{},
                  &tmp_row_max, seq<0>{});

  row_max_[0] = fmax(row_max_[0], tmp_row_max);
