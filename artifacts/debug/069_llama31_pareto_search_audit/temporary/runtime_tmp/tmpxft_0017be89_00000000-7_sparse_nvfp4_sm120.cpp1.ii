 void store_with_pointer_offset(
    Fragment const &frag,
    Index pointer_offset) const {

    TensorRef offset_ref(ref_);
    offset_ref.add_pointer_offset(pointer_offset);

    #pragma unroll
    for (int mma_n = 0; mma_n < Policy::MmaIterations::kColumn; ++mma_n) {
