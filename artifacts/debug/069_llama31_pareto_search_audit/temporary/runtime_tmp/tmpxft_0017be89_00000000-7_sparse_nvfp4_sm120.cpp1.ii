Array<float, 4> top_4_reduce(Array<float, 4> a, Array<float, 4> b) {
  Array<float, 4> out;
  asm volatile(
      "{\n"
      "  .reg .f32 mxa0b1;\n"
      "  .reg .f32 mxa1b0;\n"

      "  .reg .f32 mxa2b0;\n"
      "  .reg .f32 mxa1b1;\n"
      "  .reg .f32 mxa0b2;\n"

