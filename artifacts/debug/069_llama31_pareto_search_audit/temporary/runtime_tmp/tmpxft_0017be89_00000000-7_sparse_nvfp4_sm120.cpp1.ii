# 534 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/threadblock/regular_tile_access_iterator_tensor_op_sm80.h"
 void add_pointer_offset(LongIndex pointer_offset) {

    pointer_ += pointer_offset / ThreadMap::kElementsPerAccess;
  }


  
# 540 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/threadblock/regular_tile_access_iterator_tensor_op_sm80.h" 3 4
 __inline__ __attribute__((always_inline)) __attribute__((device))
  
# 541 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/threadblock/regular_tile_access_iterator_tensor_op_sm80.h"
 AccessType *get() const {


    int uniform_offset = (iteration_strided_ & 0x3) * stride_ + (iteration_strided_ >> 3) * 16 + stride_ * ThreadMap::Delta::kContiguous * iteration_contiguous_;

    char *access_byte_ptr = reinterpret_cast<char *>(pointer_ + uniform_offset);

    int byte_offset;



    if (Detail::kPointerCount == 2 && (iteration_strided_ & 0x4)) {
      byte_offset = byte_offset_[1];
    }
    else {
      byte_offset = byte_offset_[0];
    }

    return reinterpret_cast<AccessType *>(access_byte_ptr + byte_offset);
  }


  
# 563 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/threadblock/regular_tile_access_iterator_tensor_op_sm80.h" 3 4
