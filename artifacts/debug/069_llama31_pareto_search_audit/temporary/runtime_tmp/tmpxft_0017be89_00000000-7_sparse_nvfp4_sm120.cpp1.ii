namespace cutlass {
namespace reference {
namespace device {
namespace kernel {




namespace detail {


template <typename Func, int Rank, int RankRemaining>
struct TensorForEachHelper {


  __inline__ 
# 54 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/kernel/tensor_foreach.h" 3 4
            __attribute__((device))
  
# 55 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/kernel/tensor_foreach.h"
 TensorForEachHelper(Func &func, Coord<Rank> const &size, Coord<Rank> &coord, int64_t index) {

    int64_t product = 1;

    #pragma unroll
    for (int i = Rank - RankRemaining; i < Rank; ++i) {
      product *= size[i];
    }

    coord[Rank - 1 - RankRemaining] = index / product;
    int64_t remaining = index % product;

    TensorForEachHelper<Func, Rank, RankRemaining-1>(func, size, coord, remaining);
  }
};


template <typename Func, int Rank>
struct TensorForEachHelper<Func, Rank, 0> {


  __inline__ 
# 76 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/kernel/tensor_foreach.h" 3 4
            __attribute__((device))
  
# 77 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/tools/util/include/cutlass/util/reference/device/kernel/tensor_foreach.h"
 TensorForEachHelper(Func &func, Coord<Rank> const &size, Coord<Rank> &coord, int64_t index) {

    coord[Rank - 1] = index;

    if (coord < size) {
      func(coord);
    }
  }
};

}




