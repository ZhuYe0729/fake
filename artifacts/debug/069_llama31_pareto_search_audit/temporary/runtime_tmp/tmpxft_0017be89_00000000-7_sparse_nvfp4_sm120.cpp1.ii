 RegularTileAccessIterator operator++(int) {

    RegularTileAccessIterator prev(*this);

    this->operator++();

    return prev;
  }


  
# 598 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/transform/threadblock/regular_tile_access_iterator_tensor_op_sm80.h" 3 4
