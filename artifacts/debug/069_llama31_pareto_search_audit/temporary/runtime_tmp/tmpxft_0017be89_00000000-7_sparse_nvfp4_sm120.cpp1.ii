template <class CopyOp,
          class TS, class SLayout,
          class TD, class DLayout>

# 3518 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cute/atom/copy_traits_sm100.hpp" 3 4
