template <cute::UMMA::Major major, class ElementType, class BLK_MN, class BLK_K>

# 80 "/root/wja/project/my/cospaq/fake/fake/kernels/cutlass/cutlass_wrapper/cutlass/include/cutlass/gemm/collective/builders/sm100_common.inl" 3 4
