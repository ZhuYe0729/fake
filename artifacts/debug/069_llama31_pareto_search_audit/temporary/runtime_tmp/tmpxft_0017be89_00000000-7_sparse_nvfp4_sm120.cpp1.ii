        if constexpr (ScaleMsPerWave > 1 && ScaleNsPerTile == 1) {
          ElementBlockScale scale_b = tCrSFB(_0{});
          #pragma unroll
          for (int i = 0; i < size(filter_zeros(tCrSFA_local)); i++) {
