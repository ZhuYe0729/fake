# Copy this file to config.env and edit only this file after moving machines.
# Source it from the repository root: source artifacts/debug/063_.../config.env

export COSPAQ_REPO_ROOT="/path/to/cospaq/fake"
export COSPAQ_VLLM_ROOT="/path/to/cospaq/test/vllm"
export COSPAQ_MODEL_PATH="/path/to/Llama-2-7b-chat-hf"
export COSPAQ_DATA_ROOT="/path/to/offline/datasets"
export COSPAQ_BERTSCORE_MODEL="/path/to/roberta-large"
export COSPAQ_IWSLT_FILTER_TOKENIZER="/path/to/Llama-2-7b-chat-hf"

# A new, writable experiment root. Do not point this at 054, 056, or 060.
export COSPAQ_RUN_ROOT="$COSPAQ_REPO_ROOT/artifacts/debug/063_llama2_two_scenario_reproduction_workflow/runs/llama2_7b_chat"
export COSPAQ_CANONICAL_DIR="$COSPAQ_RUN_ROOT/shared/canonical/prepared"
export COSPAQ_EXT_CACHE_ROOT="$COSPAQ_RUN_ROOT/shared/extension_cache"

# The two environments deliberately use different interpreters.
export COSPAQ_PYTHON="/path/to/miniconda3/envs/cospaq/bin/python"
export VLLM_PYTHON="/path/to/miniconda3/envs/vllm/bin/python"
export COSPAQ_GPUS="0,1,2,3"

# Offline execution is the reproducible default. Override only if intentional.
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export VLLM_USE_V1=1

